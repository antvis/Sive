{
  "name": "sive",
  "productName": "Sive",
  "version": "0.1.0",
  "private": true,
  "description": "An independent open-source desktop workbench for AntV AVA visual analytics.",
  "license": "MIT",
  "author": "AntV AI Visualization Team",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "electron:install": "install-electron",
    "dev": "electron-vite dev --watch",
    "check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "electron-vite build",
    "start": "electron .",
    "package": "pnpm run build && electron-packager . --icon=assets/sive --out=release --overwrite --ignore=^/(src|docs|samples|.git|.github)$",
    "format": "prettier --write src electron.vite.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.98",
    "@antv/ava": "^4.0.0-beta.3",
    "@antv/gpt-vis": "^1.0.2",
    "@hookform/resolvers": "^7.0.2",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-table": "^8.21.3",
    "adm-zip": "^0.6.1",
    "ai": "^7.0.146",
    "better-sqlite3": "13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "markdown-it": "^14.1.0",
    "mysql2": "^3.24.6",
    "react-resizable-panels": "^4.18.1",
    "react-router": "^7.18.5",
    "saxes": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "18.4.4",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.4",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.1",
    "electron-vite": "^6.0.0",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@10.30.3",
  "config": {
    "electron": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
