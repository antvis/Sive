{
  "name": "sive",
  "productName": "Sive",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, open source data management and analysis software based on AVA v4.",
  "license": "MIT",
  "author": "AntV AI Visualization Team",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "electron:install": "install-electron",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "package": "pnpm run build && electron-packager . --icon=assets/sive --out=release --overwrite --ignore=\"^/(src|docs|samples|site|.git|.github)$\"",
    "tsc": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "npm run tsc && oxlint --deny-warnings src electron.vite.config.ts",
    "fix": "prettier --write src electron.vite.config.ts .prettierrc.json package.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.84",
    "@ai-sdk/react": "4.0.170",
    "@antv/ava": "4.0.4",
    "@antv/gpt-vis": "^1.3.2",
    "@hookform/resolvers": "^7.0.2",
    "@modelcontextprotocol/client": "^2.4.0",
    "@posthog/electron": "0.1.0",
    "@sentry/electron": "8.4.0",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-table": "^8.21.3",
    "@zumer/snapdom": "^2.22.0",
    "ai": "^7.0.146",
    "better-sqlite3": "13.0.3",
    "bignumber.js": "^9.3.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.1.0",
    "react-resizable-panels": "^4.18.1",
    "react-router": "^7.18.5",
    "size-sensor": "^1.0.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/osx-sign": "^2.7.2",
    "@electron/packager": "18.4.4",
    "@streamdown/cjk": "^1.0.5",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.4",
    "@streamdown/mermaid": "^1.0.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@xyflow/react": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "electron": "44.9.1",
    "electron-vite": "^6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "lucide-react": "^1.76.0",
    "nanoid": "^5.1.16",
    "oxlint": "1.93.0",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "shiki": "^3.23.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.8.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "oxlint --deny-warnings --ignore-pattern site/** --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@10.30.3",
  "config": {
    "electron": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "repository": "git@github.com:antvis/Sive.git"
}
